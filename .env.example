# Copy to .env (dev). Production values go into the PROD_ENV GitHub secret
# (see README > Deploy). Values are not quoted.

# --- Option A: hosted Supabase (Dashboard > Connect / Project Settings) ---
# Use the *Session pooler* string; the direct host is IPv6-only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only if the project still signs JWTs with the legacy secret (Settings > JWT Keys).
SUPABASE_JWT_SECRET=

# --- Option B: local Supabase (`supabase start`, values from `supabase status`) ---
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321   # how the backend container reaches it
# SUPABASE_PUBLISHABLE_KEY=<publishable (or anon) key from `supabase status`>
# SUPABASE_JWT_SECRET=<JWT secret from `supabase status`>
# Then run `supabase migration up` after adding a migration (not db-push).
