# Copy to .env (dev) or .env.production (deploy, see README).
# Values are not quoted, and comments go on their own lines.

# --- Supabase, option A: hosted (Project Settings > API Keys) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend only, bypasses RLS. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Supabase, option B: local (`make db-start`, values from `supabase status`) ---
# SUPABASE_URL=http://127.0.0.1:54321
# How the backend container reaches local Supabase:
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# --- LLM via Haystack: openai, gemini, or none (no key needed, /api/ask disabled) ---
LLM_PROVIDER=none
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Empty uses the integration's default (gpt-5-mini / gemini-3.8-flash).
CHAT_MODEL=

# --- Langfuse tracing, optional (cloud.langfuse.com > Settings > API Keys) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud. US: https://us.cloud.langfuse.com, or a self-hosted URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps dev and demo traces apart; use demo in .env.production.
LANGFUSE_TRACING_ENVIRONMENT=development
