# App config shared by the team. `./hack setup` copies this to .env (and later
# adds keys that are new here). Supabase isn't set here: `./hack dev` uses the
# local stack, and `./hack deploy` creates the hosted project.
# Share your filled-in .env with the team: ./hack env share  (they: ./hack env pull)
# Values are not quoted, and comments go on their own lines.

# --- LLM, via Haystack ---
# Paste the key your hackathon partner gives you. The provider is picked from
# whichever key is set (Anthropic, then OpenAI, then Gemini).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# An OpenAI-compatible partner API: its base URL here, its key in OPENAI_API_KEY.
OPENAI_BASE_URL=
GOOGLE_API_KEY=
# auto, anthropic, openai, gemini or none: forces one when several keys are set.
LLM_PROVIDER=auto
# Empty uses the default: claude-opus-5-5, gpt-5-mini or gemini-3.8-flash.
CHAT_MODEL=

# --- Langfuse tracing, optional: cloud.langfuse.com > your project > Settings > API Keys ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud. US: https://us.cloud.langfuse.com, or a self-hosted URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps local traces apart from production's (deploys set "production").
LANGFUSE_TRACING_ENVIRONMENT=development
