# Copy to .env (dev) or .env.production (deploy, see README). Values are not quoted.

# --- Option A: hosted Supabase (Project Settings > API Keys) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend only, bypasses RLS. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Option B: local Supabase (`make db-start`, values from `supabase status`) ---
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321   # how the backend container reaches it
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
