terraform {
  required_version = ">= 1.6"

  required_providers {
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "~> 1.70"
    }
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.28"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.4"
    }
  }
}

# Credentials come from the environment: HCLOUD_TOKEN and CLOUDFLARE_API_TOKEN.
provider "hcloud" {}
provider "cloudflare" {}
